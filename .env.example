# Modelo. Copie para .env.local e preencha com os valores reais.
#
# ⚠️ NUNCA preencha ESTE arquivo — ele vai para o git.
#    Os valores reais moram só no .env.local, que o .gitignore ignora.

# ---------------------------------------------------------------------------
# Senha da role de leitura fdw_se, criada nos dois bancos de origem pelo
# sql/00_roles_remotos.sql. VOCÊ escolhe — não precisa ser a senha de ninguém.
# Depois repita esse mesmo valor em SENHA_ANCHOR e SENHA_QV.
# ---------------------------------------------------------------------------
SENHA_FDW=

# ---------------------------------------------------------------------------
# ANCHOR (sfxbzfaxbbdjzuhzzrjc) — origem dos dados de tráfego (core.ads_metrics)
# ---------------------------------------------------------------------------
# Conexão DIRETA (tente primeiro):
#   HOST_ANCHOR=db.sfxbzfaxbbdjzuhzzrjc.supabase.co
#   USER_ANCHOR=postgres
# Se der timeout (rede sem IPv6), use o SESSION POOLER — o usuário muda:
#   HOST_ANCHOR=aws-0-<regiao>.pooler.supabase.com
#   USER_ANCHOR=postgres.sfxbzfaxbbdjzuhzzrjc
HOST_ANCHOR=
USER_ANCHOR=
SENHA_ANCHOR=

# ---------------------------------------------------------------------------
# BACKUP BASE QV (lacinxsvjdwalkchxyeo) — agendamentos, comparecimento, vendas
# Projeto de outro setor: só leitura.
# ---------------------------------------------------------------------------
HOST_QV=
USER_QV=
SENHA_QV=

# ---------------------------------------------------------------------------
# BUSINESS DATA (rckpuebaiswrxzmywllv) — o hub. Usado pelos scripts de leitura.
# A service_role fica AQUI e nunca com prefixo VITE_.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://rckpuebaiswrxzmywllv.supabase.co
SUPABASE_SERVICE_ROLE=
